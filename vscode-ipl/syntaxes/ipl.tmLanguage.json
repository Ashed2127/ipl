{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IPL",
  "scopeName": "source.ipl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#function-declarations" },
    { "include": "#function-calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ipl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ipl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ipl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ipl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ipl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ipl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ipl",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.ipl",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ipl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ipl",
          "match": "\\b(null|none|nil)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ipl",
          "match": "\\b(if|else|while|for|in|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.ipl",
          "match": "\\b(let|var|fn|import|as)\\b"
        },
        {
          "name": "keyword.other.security.ipl",
          "match": "\\b(intent|where|sanitize|trusted)\\b"
        },
        {
          "name": "keyword.other.io.ipl",
          "match": "\\b(print)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.ipl",
          "match": "\\b(Currency|Sentiment|Quantity|Prob|Intent|Int|Float|String|Bool|List|Dict|Any)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ipl",
          "match": "\\b(db_write|audit_trace|sha256|md5|base64_encode|base64_decode|json_encode|json_decode|now)\\b"
        }
      ]
    },
    "function-declarations": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "keyword.declaration.ipl" },
        "2": { "name": "entity.name.function.ipl" }
      }
    },
    "function-calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "variable.function.ipl" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ipl",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.ipl",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.ipl",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arithmetic.ipl",
          "match": "(\\+|\\-|\\*|/|%)"
        }
      ]
    }
  }
}
