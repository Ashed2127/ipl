// ATTACK 34: Man-in-the-Middle via SSL Stripping
class MITMAttack {
    function attack_mitm() {
        // Attempt to connect without SSL
        let insecure_request = Request(
            url: "http://example.com/login", // Not https
            body: {"username": "admin", "password": "password"}
        )
        send_request(insecure_request)
    }
}

