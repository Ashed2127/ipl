// ============================================================================
// IPL Demo 05: Built-in Security Engine Demo
// ============================================================================
// This demonstrates IPL's built-in malicious code and data detection
// without using external libraries.

print "=========================================================="
print "       1. MALICIOUS CODE DETECTION DEMO                  "
print "=========================================================="
print "Attempting to run code with dangerous patterns..."
print "Note: This would be blocked in actual execution"
print "Examples of blocked patterns: eval(), exec(), os.system(), etc."

print "\n=========================================================="
print "       2. MALICIOUS DATA DETECTION DEMO                  "
print "=========================================================="

// Test 1: Credit card number detection
let user_input = "My credit card is 4532-1234-5678-9010 please don't steal it"
print "Original input:", user_input

let safe_input: String = user_input
print "After security analysis:", safe_input

// Test 2: API key detection
let config_data = "api_key = sk-1234567890abcdef1234567890abcdef"
print "Config data:", config_data

let safe_config: String = config_data
print "After security analysis:", safe_config

// Test 3: Malicious URL detection
let suspicious_link = "Download from https://evil.com/malware.exe"
print "Suspicious link:", suspicious_link

let safe_link: String = suspicious_link
print "After security analysis:", safe_link

print "\n=========================================================="
print "       3. TRUSTED VARIABLE DEMO                          "
print "=========================================================="
print "Using 'trusted' keyword to bypass security checks for known safe data"

trusted safe_system_data = "This is known safe system configuration data"
print safe_system_data

print "\n=========================================================="
print "       4. SECURITY SUMMARY                                "
print "=========================================================="
print "IPL Security Engine Features:"
print "• Malicious code pattern detection (eval, exec, system calls)"
print "• Data security analysis (PII, credentials, credit cards)"
print "• Automatic data sanitization"
print "• Trusted variable bypass for known-safe data"
print "• Real-time threat level assessment"
print "• No external libraries required - all built-in"