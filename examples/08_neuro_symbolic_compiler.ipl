// ==============================================================================
// 08. NEURO-SYMBOLIC COMPILER & ZERO-TRUST MATHEMATICAL FIREWALL
// Demonstrates:
// 1. System 1 (Neural Generation) & System 2 (Symbolic Verification)
// 2. The Self-Correction Loop (Textual repair "twenty-five" -> 25)
// 3. Zero-Trust Data Taint Tracking (Untrusted -> SanitizationNode -> Sinks)
// 4. Cryptographic-grade Verified Audit Trace with SHA256 step signatures
// ==============================================================================

print "======================================================================"
print "       1. SYSTEM 1 NEURAL PARSE & SYSTEM 2 SYMBOLIC VERIFICATION      "
print "======================================================================"

// System 1 generates an initial candidate AST from natural language.
// The text says "twenty-five", but the contract specifies Int.
// The Self-Correction Loop detects the TypeMismatch diagnostic and repairs it!
let extracted_age: Int = intent "Extract user_age twenty-five from employee record" as Int

print "Extracted & Verified Age :", extracted_age
print "Provenance Taint Level   :", taint_of(extracted_age)

print ""
print "======================================================================"
print "       2. CURRENCY & SENTIMENT INTENT COMPILATION                    "
print "======================================================================"

let budget: Currency = intent "Budget allocation is 12500 euros for Q3" as Currency
print "Compiled Budget Allocation:", budget
print "Budget Taint Level        :", taint_of(budget)

let feedback: Sentiment = intent "The compiler speed is breathtaking and execution is rock solid!" as Sentiment
print "Feedback Classification   :", feedback
print "Feedback Taint Level      :", taint_of(feedback)

print ""
print "======================================================================"
print "       3. ZERO-TRUST TAINT TRACKING & SANITIZATION NODES              "
print "======================================================================"

// Neural outputs are strictly tagged as 'Untrusted'.
// Critical sinks (db_write, file_write) FAIL-CLOSED if passed Untrusted data.
print "Checking taint before DB commitment: ", taint_of(extracted_age)

// Pass untrusted value through a deterministic SanitizationNode
let sanitized_age = sanitize(extracted_age, "range_and_provenance_verifier")
print "Taint after SanitizationNode       : ", taint_of(sanitized_age)

// Critical sink: db_write requires Sanitized or Trusted taint
print "Writing sanitized record to database sink:"
let db_result = db_write("personnel_registry", sanitized_age)
print "Database Write Status: ", db_result

// Critical sink: file_write
let audit_payload = "Employee Record: Age=" + sanitized_age
let file_result = file_write("/tmp/verified_personnel.log", audit_payload)
print "File Write Status: ", file_result

print ""
print "======================================================================"
print "       4. TRUSTED DECLARATION EXEMPTIONS                              "
print "======================================================================"

// Compile-time trusted variables explicitly bypass taint tracking
trusted let system_master_key = "AUTH_TOKEN_SHA256_INTERNAL_ONLY"
print "Master Key Taint :", taint_of(system_master_key)
let auth_res = db_write("auth_registry", system_master_key)
print "Auth Write Status:", auth_res

print ""
print "======================================================================"
print "       5. PER-STEP CRYPTOGRAPHIC VERIFIED AUDIT TRACE                 "
print "======================================================================"

// Render the immutable per-step audit trace with SHA256 cryptographic signatures
print "Rendering complete compiler audit trace:"
audit_trace()
